{
  "name": "@kubohiroya/qrcode-structured-append",
  "version": "0.1.1",
  "description": "QR Code Structured Append (ISO/IEC 18004): split a message into up to 16 linked QR symbols, and join them back from any decoder's reads.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/qrcode-structured-append#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/qrcode-structured-append.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/qrcode-structured-append/issues"
  },
  "keywords": [
    "qrcode",
    "qr",
    "structured-append",
    "iso-18004",
    "multipart"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "build": "vite build && tsc --project tsconfig.build.json",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nuintun/qrcode": "5.0.3",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "zxing-wasm": "3.1.4"
  },
